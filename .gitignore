# Safety net for the whole monorepo. Each app also has its own .gitignore.

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Secrets (keep *.example files tracked)
.env
.env.*
!.env.example
*.pem

# Dependencies / build output
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.next/
dist/
build/
out/
.output/
.vinxi/
.tanstack/
.wrangler/

# Logs / runtime artifacts
*.log
*.pid
*.db
*.tsbuildinfo
